api.sih.shubhang.dev {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Caddy forwards Upgrade/Connection headers unchanged, so WebSocket
	# proxying needs no special directive.
	reverse_proxy 127.0.0.1:3040

	# The relay takes its publish secret and write token from an Authorization
	# header, but still accepts ?token= for compatibility - and `request.uri`
	# is logged verbatim into journald, where it is readable by anyone with a
	# shell on a box that hosts five production services. Redact the parameter
	# rather than trusting every client to use the header.
	#
	# Credential HEADERS (Authorization, Cookie) are already redacted by
	# Caddy's default `log_credentials off`.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					replace token REDACTED
				}
			}
		}
	}
}
